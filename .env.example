# Optional. Base URL used for metadata/OpenGraph/robots.txt/sitemap.xml
# (lib/constants.ts#SITE_URL). Defaults to https://www.cyberjus.org - only
# set it when deploying to a different domain (e.g. a staging host).
# NEXT_PUBLIC_* is inlined at build time: set it as a build variable.
NEXT_PUBLIC_SITE_URL=
