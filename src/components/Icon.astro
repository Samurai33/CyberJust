---
// Ícones SVG inline (sem fonte de ícones, sem JS). Decorativos: aria-hidden.
// "fill": glifos sólidos de interface. "line": ícones de traço.
type Fill = 'arrow' | 'check' | 'menu' | 'external' | 'play' | 'pause' | 'back15' | 'fwd30' | 'close' | 'share' | 'download' | 'vol' | 'mute';
type Line = 'shield' | 'lock' | 'alert' | 'flag' | 'clock' | 'calendar' | 'load' | 'access' | 'rss' | 'list';
interface Props { name: Fill | Line; size?: number; class?: string }
const { name, size = 16, class: cls } = Astro.props;
const fill: Record<Fill, string> = {
  arrow: 'M13.2 5.3 19.9 12l-6.7 6.7-1.4-1.4 4.3-4.3H4v-2h12.1l-4.3-4.3z',
  check: 'M9.5 16.2 5.3 12l-1.4 1.4 5.6 5.6L21 7.5l-1.4-1.4z',
  menu: 'M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z',
  external: 'M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14zM5 5h6v2H7v10h10v-4h2v6H5z',
  play: 'M8 5.1v13.8a1 1 0 0 0 1.5.9l11-6.9a1 1 0 0 0 0-1.7l-11-6.9A1 1 0 0 0 8 5.1z',
  pause: 'M7 5h3.5v14H7zm6.5 0H17v14h-3.5z',
  back15: 'M12 5V2L7 6l5 4V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8zm-2.6 5.6H8.2v-.9l1.8-.6h.4V16H9.4zm4.7 5.5c-.8 0-1.6-.4-1.8-1.3l.9-.3c.1.5.5.7.9.7.6 0 1-.4 1-1s-.4-1-1-1c-.3 0-.6.1-.8.3l-.8-.2.4-3.2h3v.9h-2.2l-.2 1.5c.2-.1.5-.2.8-.2 1 0 1.8.7 1.8 1.9s-.8 1.9-2 1.9z',
  fwd30: 'M12 5V2l5 4-5 4V7a6 6 0 1 0 6 6h2a8 8 0 1 1-8-8zm-2.9 11.1c-.9 0-1.6-.4-1.8-1.2l.8-.4c.1.5.5.7 1 .7s.9-.3.9-.8-.4-.8-1-.8h-.4v-.8h.4c.5 0 .9-.3.9-.7s-.3-.7-.8-.7c-.4 0-.7.2-.9.6l-.8-.4c.3-.7.9-1.1 1.7-1.1 1 0 1.7.6 1.7 1.4 0 .5-.3.9-.8 1.1.6.2.9.6.9 1.2 0 1-.8 1.6-1.8 1.6zm4.6 0c-1.1 0-1.7-.9-1.7-2.5s.6-2.5 1.7-2.5 1.7.9 1.7 2.5-.6 2.5-1.7 2.5zm0-.9c.5 0 .7-.5.7-1.6s-.2-1.6-.7-1.6-.7.5-.7 1.6.2 1.6.7 1.6z',
  close: 'M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6l5.6-5.6L5 6.4z',
  share: 'M12 2.6 16.7 7.3l-1.4 1.4L13 6.4V15h-2V6.4L8.7 8.7 7.3 7.3zM5 11h3v2H6v7h12v-7h-2v-2h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z',
  download: 'M11 3h2v9.6l3.3-3.3 1.4 1.4L12 16.4l-5.7-5.7 1.4-1.4 3.3 3.3zM4 18h16v2H4z',
  vol: 'M4 9h4l5-4v14l-5-4H4zm12.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z',
  mute: 'M4 9h4l5-4v14l-5-4H4zm12.6.2 1.4-1.4 2 2 2-2 1.4 1.4-2 2 2 2-1.4 1.4-2-2-2 2-1.4-1.4 2-2z',
};
const line: Record<Line, string> = {
  shield: 'M12 3 19 6v5.5c0 4.4-2.9 8-7 9.5-4.1-1.5-7-5.1-7-9.5V6zM9 12l2 2 4-4',
  lock: 'M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3',
  alert: 'M12 4 21 20H3zM12 10v4M12 17h.01',
  flag: 'M5 21V4M5 4h11l-2 4 2 4H5',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2',
  calendar: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4',
  load: 'M12 3a9 9 0 1 0 9 9',
  // símbolo internacional de acessibilidade (pessoa em círculo), LBI art. 63 §1º
  access: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7.5h.01M7.5 10l4.5 1 4.5-1M12 11v3l-2 4M12 14l2 4',
  rss: 'M5 5a14 14 0 0 1 14 14M5 11a8 8 0 0 1 8 8M6 19h.01',
  list: 'M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01',
};
const isLine = name in line;
---
{isLine ? (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d={line[name as Line]} /></svg>
) : (
  <svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d={fill[name as Fill]} /></svg>
)}
