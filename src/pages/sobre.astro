---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Trilha from '../components/Trilha.astro';
import Icon from '../components/Icon.astro';
import retrato from '../assets/img/thiago-rangel.png';
import { trilhaLd } from '../lib/ld';
import { APRESENTADOR, ESPECIALISTAS, LD, N3XUS, SITE } from '../data/site';

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Sobre', href: '/sobre/' },
];
const perfil = {
  '@type': 'ProfilePage',
  url: new URL('/sobre/', Astro.site).href,
  mainEntity: {
    '@type': 'Person',
    '@id': LD.thiago,
    name: APRESENTADOR.nome,
    alternateName: APRESENTADOR.apelido,
    jobTitle: 'Especialista em cibersegurança',
    description: APRESENTADOR.texto,
    image: new URL('/icon-512.png', Astro.site).href,
    worksFor: { '@id': LD.n3xus },
    sameAs: APRESENTADOR.links.map((l) => l.href),
    knowsAbout: ['Cibersegurança', 'Testes de intrusão', 'Engenharia de software', 'Inteligência artificial'],
  },
};
const n3xus = { '@type': 'Organization', '@id': LD.n3xus, name: N3XUS.marca, legalName: N3XUS.razao, taxID: N3XUS.cnpj, url: N3XUS.site, email: N3XUS.email };
---
<Base title="Sobre o podcast e o especialista" description="Quem faz o CyberJustiça Brasil, quem é o especialista Thiago Rangel (Samurai) e como o conteúdo é produzido e verificado." jsonLd={[perfil, n3xus, trilhaLd(Astro.site, trilha)]}>
  <section class="page-head">
    <div class="wrap">
      <Trilha itens={trilha} />
      <h1>Sobre o CyberJustiça Brasil</h1>
      <p class="lede">{SITE.descricao}</p>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="esp-t">
    <div class="wrap">
      <figure class="surface host">
        <Image src={retrato} alt="Retrato de Thiago Rangel em arte ASCII azul sobre fundo escuro" widths={[200, 400]} sizes="200px" loading="eager" />
        <figcaption>
          <p class="label"><b>Especialista</b> / apresentador</p>
          <h2 id="esp-t">{APRESENTADOR.nome} <span>({APRESENTADOR.apelido})</span></h2>
          <p class="cargo">{APRESENTADOR.cargo}</p>
          <p>{APRESENTADOR.texto}</p>
          <p class="actions">
            {APRESENTADOR.links.map((l) => (
              <a class="link-arrow" href={l.href} rel="me noopener noreferrer" target="_blank">{l.label} <Icon name="external" size={12} /></a>
            ))}
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="como-t">
    <div class="wrap grid-2">
      <header class="sec-head"><p class="label">Transparência</p><h2 id="como-t">Como produzimos</h2></header>
      <div class="prose">
        <ul>
          <li><strong>Casos reais e fontes primárias.</strong> Cada episódio cita as leis e os canais oficiais envolvidos, com link para a fonte (Planalto, Banco Central, SaferNet, Polícia Federal).</li>
          <li><strong>Nada inventado.</strong> Números, nomes e datas só entram com fonte. Quando algo muda, a página do episódio mostra a data de revisão.</li>
          <li><strong>Convidados identificados.</strong> Especialistas falam pelo cargo que ocupam; o site nunca publica contatos pessoais.</li>
          <li><strong>Uso de IA.</strong> Ferramentas de IA podem ajudar em transcrição e revisão de texto; o conteúdo é sempre conferido por uma pessoa antes de publicar.</li>
          <li><strong>Correções.</strong> Achou um erro? Escreva para <a href={`mailto:${N3XUS.email}`}>{N3XUS.email}</a>.</li>
        </ul>
        <p>O site é mantido pela <a href={N3XUS.site} rel="noopener">N3XUS</a> ({N3XUS.razao}, CNPJ {N3XUS.cnpj}) e o código é aberto no <a href={SITE.repo} rel="noopener noreferrer">GitHub</a>.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="conv-t">
    <div class="wrap">
      <header class="sec-head"><p class="label">Convidados</p><h2 id="conv-t">Quem já participou</h2></header>
      <ul class="pessoas" role="list">
        {ESPECIALISTAS.map((p) => (
          <li class="surface pessoa">
            <h3>{p.nome}</h3>
            <p class="cargo">{p.cargo}</p>
            <p>{p.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
