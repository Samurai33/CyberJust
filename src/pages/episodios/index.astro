---
import Base from '../../layouts/Base.astro';
import LinhaEpisodio from '../../components/LinhaEpisodio.astro';
import Trilha from '../../components/Trilha.astro';
import { listarEpisodios, urlEpisodio } from '../../lib/episodios';
import { trilhaLd } from '../../lib/ld';
import { TEMAS, type Tema } from '../../data/temas';
import { LD } from '../../data/site';

const episodios = await listarEpisodios();
const conta = (t: Tema) => episodios.filter((e) => e.data.tema === t).length;
const filtros = [
  { id: 'todos', rotulo: 'Todos', n: episodios.length },
  { id: 'audio', rotulo: 'Com áudio', n: episodios.filter((e) => e.data.audio).length },
  ...(Object.keys(TEMAS) as Tema[]).map((t) => ({ id: t, rotulo: TEMAS[t].curto, n: conta(t) })),
].filter((f) => f.n > 0);
const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Episódios', href: '/episodios/' },
];
const lista = {
  '@type': 'ItemList',
  name: 'Episódios do CyberJustiça Brasil',
  itemListElement: episodios.map((e, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(urlEpisodio(e), Astro.site).href })),
  isPartOf: { '@id': LD.serie },
};
---
<Base
  title="Todos os episódios do podcast"
  description="Todos os episódios do CyberJustiça Brasil: fraudes digitais, vazamento de dados, corrupção nas redes e proteção de crianças online."
  jsonLd={[lista, trilhaLd(Astro.site, trilha)]}
>
  <section class="page-head">
    <div class="wrap">
      <Trilha itens={trilha} />
      <h1>Todos os episódios</h1>
      <p class="lede">Cada episódio traz o caso, quem investigou, as leis envolvidas e o que fazer para se proteger.</p>
    </div>
  </section>
  <section class="section section-tight" aria-label="Lista de episódios">
    <div class="wrap lista">
      <fieldset class="filtro">
        <legend class="label">Filtrar</legend>
        {filtros.map((f, i) => (
          <>
            <input type="radio" name="filtro" id={`f-${f.id}`} checked={i === 0} />
            <label for={`f-${f.id}`}>{f.rotulo} <span>{f.n}</span></label>
          </>
        ))}
      </fieldset>
      <div class="index">
        {episodios.map((ep) => <LinhaEpisodio ep={ep} nivel="h2" />)}
      </div>
    </div>
  </section>
</Base>
